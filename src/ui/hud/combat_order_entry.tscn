[node name="NameLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
clip_text = true

[node name="ReadinessBar" type="ProgressBar" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 10)
layout_mode = 2
theme_override_styles/background = ExtResource("2_bar_bg")
theme_override_styles/fill = ExtResource("3_readiness_fill")
show_percentage = false
