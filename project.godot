config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="NE- Call of the Abyss (2D)"
config/version="0.1"
run/main_scene="res://UI/MainMenu/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/image="uid://b5ubgw6jktu33"
config/icon="uid://b5ubgw6jktu33"

[autoload]

GlobalLevelManager="*res://Globals/GlobalLevelManager.gd"

[display]

window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="RPG-SW"

