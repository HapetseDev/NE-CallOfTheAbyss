varying_name = "world_pos"
varying_type = 4

[sub_resource type="VisualShaderNodeIf" id="VisualShaderNodeIf_d4po3"]
default_input_values = [0, 0.0, 1, 0.0, 2, 1e-05, 3, Vector3(0, 0, 0), 4, Vector3(0, 0, 0), 5, Vector3(1, 0, 0)]
expanded_output_ports = [0]

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_j4053"]
size = Vector2(1040, 780.00006)
expression = "out = 100000.0;
if (cutout_enabled) {
    for (int i = 0; i < subject_count; i++) {
        vec3 center = subjects[i].xyz;
        vec3 axis = normalize(INV_VIEW_MATRIX[2].xyz);
        bool standing_floor = abs(normalize(cross(dFdx(p), dFdy(p))).y) > 0.65 && p.y <= subjects[i].w + 0.35;
        if (standing_floor || dot(p - center, axis) <= 0.35 || cutout_hits[i].w <= 0.001) { continue; }
        // dmlary / Inigo Quilez: signed distance to the camera-to-hit capsule.
        vec3 end_a = INV_VIEW_MATRIX[3].xyz;
        if (PROJECTION_MATRIX[3][3] > 0.5) {
            end_a = center + axis * dot(end_a - center, axis);
        }
        vec3 pa = p - end_a, ba = cutout_hits[i].xyz - end_a;
        float h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.00001), 0.0, 1.0);
        out = min(out, length(pa - ba * h) - cutout_hits[i].w);
    }
}"

