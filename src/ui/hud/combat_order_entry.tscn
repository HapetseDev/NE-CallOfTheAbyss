[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/hud/combat_order_entry.gd" id="1_entry"]
[ext_resource type="StyleBoxFlat" path="res://src/ui/components/indicators/bar_background.tres" id="2_bar_bg"]
[ext_resource type="StyleBoxFlat" path="res://src/ui/components/indicators/readiness_fill.tres" id="3_readiness_fill"]

[node name="CombatOrderEntry" type="HBoxContainer"]
custom_minimum_size = Vector2(200, 24)
theme_override_constants/separation = 8
